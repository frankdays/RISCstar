---
// WordPress author archives redirected to the homepage; keep that behaviour.
import { getPosts } from '../../../lib/blog';
export async function getStaticPaths() {
  const slugs = new Set((await getPosts()).map((p) => p.data.authorSlug));
  return [...slugs].map((author) => ({ params: { author } }));
}
